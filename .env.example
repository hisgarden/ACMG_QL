# Google Sheets API Configuration
# Copy this file to .env and fill in your actual values

# Your Google Cloud API Key for Google Sheets access
GOOGLE_API_KEY=your_google_api_key_here

# The ID of your Google Sheet containing plant data
# You can find this in the URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional: Enable/disable Google Sheets integration
# Set to 'true' to enable, 'false' to disable (will use mock data instead)
ENABLE_GOOGLE_SHEETS=false
